{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev -p 9002 --webpack",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:icon": "node scripts/make-icon.mjs",
    "desktop:build": "next build && node scripts/prepare-desktop.mjs && node scripts/make-icon.mjs",
    "desktop:pack": "node scripts/pack-desktop.mjs",
    "dist": "npm run desktop:build && npm run desktop:pack",
    "desktop:pc-test": "tsx scripts/windows-pc-control-test.ts",
    "test:admin-actions": "tsx scripts/admin-action-coordinator-test.ts",
    "desktop:verify": "node scripts/verify-desktop-bundle.mjs"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "^1.28.0",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@sparticuz/chromium": "^149.0.0",
    "@types/pdfkit": "^0.17.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "docx": "^9.8.1",
    "dotenv": "^16.5.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^11.9.1",
    "genkit": "^1.28.0",
    "jszip": "^3.10.2",
    "katex": "^0.16.47",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.13.0",
    "mathjax-node": "^2.1.1",
    "next": "^16.2.12",
    "patch-package": "^8.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.19.1",
    "pdfkit-table": "^0.2.11",
    "prismjs": "^1.29.0",
    "puppeteer": "^25.4.0",
    "puppeteer-core": "^25.4.0",
    "react": "^19.2.1",
    "react-day-picker": "^9.11.3",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.54.2",
    "react-markdown": "^9.1.0",
    "react-simple-code-editor": "^0.14.1",
    "recharts": "^2.15.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "wav": "^1.0.2",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/wav": "^1.0.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "genkit-cli": "^1.28.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "sharp@0.34.5": true,
    "protobufjs@7.5.4": true,
    "@firebase/util@1.12.0": true
  },
  "build": {
    "appId": "com.jimskay.hackerai",
    "productName": "Jimskay AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "package.json",
      "!desktop/HackerAI Desktop Setup 0.1.0.exe"
    ],
    "extraResources": [
      {
        "from": "miktex",
        "to": "miktex"
      }
    ],
    "extraMetadata": {
      "dependencies": {},
      "devDependencies": {}
    },
    "asar": false,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jimskay AI",
      "uninstallDisplayName": "Jimskay AI"
    }
  }
}
